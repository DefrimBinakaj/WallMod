<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WallMod.ViewModels"
        xmlns:convs="using:WallMod.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ia="using:Xaml.Behaviors.Interactions.Animated"
		xmlns:models="using:WallMod.Models"
        xmlns:views="using:WallMod.Views"
        xmlns:helpers="using:WallMod.Helpers"
        WindowStartupLocation="CenterScreen"
        Width="1500"
        Height="750"
        MinWidth="700"
        MinHeight="300"
        x:Class="WallMod.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/wallmodicon.ico"
        Title="WallMod"
        Name="MainWindowAxaml"
        TransparencyLevelHint="AcrylicBlur"
        ExtendClientAreaToDecorationsHint="True">

	<Design.DataContext>
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Window.KeyBindings>
		<!-- selection actions -->
		<KeyBinding Command="{Binding addWallpaperToAutoSetCommand}"			Gesture="Q"/>
		<KeyBinding Command="{Binding addWallpaperToFavouritesCommand}"			Gesture="F"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySetBackground}"    Gesture="B"/>
		<KeyBinding Command="{Binding openImageInExplorerCommand}"				Gesture="O"/>
		<!-- views / menus -->
		<KeyBinding Command="{Binding autoSetNavCommand}"						Gesture="Shift+A"/>
		<KeyBinding Command="{Binding viewHistoryButton}"						Gesture="Shift+H"/>
		<KeyBinding Command="{Binding viewFavouritesButton}"					Gesture="Shift+F"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeyEscape}"           Gesture="Escape"/>
		<KeyBinding Command="{Binding settingsButton}"							Gesture="Shift+S" />
		<KeyBinding Command="{Binding filterClicked}"							Gesture="Ctrl+F" />
		<!-- monitors -->
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeyToggleMonitorMode}"	Gesture="M"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.DetectMonitors}"   Gesture="R"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySelectMonitor}" CommandParameter="1" Gesture="D1"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySelectMonitor}" CommandParameter="2" Gesture="D2"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySelectMonitor}" CommandParameter="3" Gesture="D3"/>
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySelectMonitor}" CommandParameter="4" Gesture="D4"/>
		<!-- thumbnailzoom  -->
		<KeyBinding Command="{Binding HotkeyPlus}"						 Gesture="OemPlus" />
		<KeyBinding Command="{Binding HotkeyMinus}"						 Gesture="OemMinus" />
		<!-- vertical slider shifting -->
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySqBraceLeft}"		 Gesture="OemOpenBrackets" />
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeySqBraceRight}"		 Gesture="OemCloseBrackets" />
		<!-- jumping to top / bottom -->
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeyG}"				 Gesture="G" />
		<KeyBinding Command="{Binding #MainWindowAxaml.HotkeyShiftG}"			 Gesture="Shift+G" />
		<!-- Backspace for navigating to parent directory (back) -->
		<KeyBinding Command="{Binding navigateToParentDirec}"					 Gesture="Back" />

	</Window.KeyBindings>

	<Panel>
		<ExperimentalAcrylicBorder IsHitTestVisible="False">
			<ExperimentalAcrylicBorder.Material>
				<ExperimentalAcrylicMaterial
					BackgroundSource="Digger"
					TintColor="{Binding SelectedBackgroundColour}"
					TintOpacity="0.4"
					MaterialOpacity="0.3" />
			</ExperimentalAcrylicBorder.Material>
		</ExperimentalAcrylicBorder>

		<Image Source="avares://Wallmod/Assets/wallmodicon.ico"
			   Width="18" Height="18"
			   HorizontalAlignment="Left" VerticalAlignment="Top"
			   Margin="8,8,0,0"
			   IsHitTestVisible="False"/>

		<Grid Margin="24" x:Name="MainGrid" IsVisible="{Binding MainGridVisibility}" Opacity="{Binding MainGridOpacity}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" MinWidth="280"/>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" MinWidth="350"/>
			</Grid.ColumnDefinitions>

			<!-- bottom row for full-width AutoSet tray -->
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!-- Left Pane: Image Gallery and Controls & History ========= -->
			<Border Grid.Column="0" Grid.Row="0" Background="{Binding SelectedWallpaperCollectionColour, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="10" Margin="8">
				<Panel>

					<!-- Image Gallery Section -->
					<Grid IsVisible="{Binding IsImageGalleryViewVisible}">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="Auto"/>
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>
						<!-- gallery buttons: faint light background on hover -->
						<Grid.Styles>
							<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
								<Setter Property="Background" Value="#1FFFFFFF"/>
								<Setter Property="BoxShadow" Value="0 0 0 0 #00000000"/>
							</Style>
						</Grid.Styles>

						<ProgressBar Grid.Row="0" Minimum="0" Maximum="100" Value="{Binding ImgLoadProgress}" Height="15" Background="Gray" Foreground="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}" VerticalAlignment="Top" CornerRadius="10,0"/>

						<Button x:Name="FilterButton" Grid.Row="1" Command="{Binding filterClicked}" Background="Transparent"
								HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0, 6, 4, 0" ToolTip.Tip="Filter By">
							<!-- funnel turns accent while any filter is on -->
							<Path Width="17" Height="17" Stretch="Uniform" Data="M2,3H22L14,13V20L10,22V13Z"
								  Fill="{Binding FilterIconColour, Converter={StaticResource ColorToBrushConverter}}"/>
						</Button>

						<Popup x:Name="FilterPopup"
							   PlacementTarget="{Binding #FilterButton}"
							   Placement="BottomEdgeAlignedRight"
							   IsLightDismissEnabled="True"
							   IsOpen="{Binding IsFilterOpen}">

							<!-- Filter Popup -->
							<Border Background="rgba(20, 20, 20, 15)" CornerRadius="8" Padding="12">
								<Border.Styles>
									<Style Selector="Border.segmentTrack" x:DataType="vm:MainWindowViewModel">
										<Setter Property="Background" Value="{Binding SelectedWallpaperCollectionColour, Converter={StaticResource ColorToBrushConverter}}"/>
										<Setter Property="HorizontalAlignment" Value="Left"/>
									</Style>
									<Style Selector="RadioButton.segmented" x:DataType="vm:MainWindowViewModel">
										<Setter Property="Background" Value="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"/>
									</Style>
									<Style Selector="TextBlock.filterLabel">
										<Setter Property="FontSize" Value="13"/>
										<Setter Property="Foreground" Value="#99FFFFFF"/>
										<Setter Property="Margin" Value="1,8,0,0"/>
									</Style>
									<Style Selector=":is(ToggleButton).segmented" x:DataType="vm:MainWindowViewModel">
										<Setter Property="Background" Value="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"/>
									</Style>
								</Border.Styles>

								<StackPanel Spacing="6">
									<TextBox x:Name="FilterSearchBox" Text="{Binding FilterSearchText}" Watermark="Search by name" Foreground="White" Background="rgba(52, 52, 52, 1)"/>

									<TextBlock Classes="filterLabel" Text="Sort by"/>
									<Border Classes="segmentTrack">
										<StackPanel Orientation="Horizontal" Spacing="2">
											<RadioButton Classes="segmented" GroupName="FilterGroup" Content="Name" IsChecked="{Binding CurrentSortChoice, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Name}"/>
											<RadioButton Classes="segmented" GroupName="FilterGroup" Content="Date" IsChecked="{Binding CurrentSortChoice, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Date}"/>
											<RadioButton Classes="segmented" GroupName="FilterGroup" Content="Size" IsChecked="{Binding CurrentSortChoice, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Size}"/>
											<RadioButton Classes="segmented" GroupName="FilterGroup" Content="Colour" IsChecked="{Binding CurrentSortChoice, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Colour}"/>
											<RadioButton Classes="segmented" GroupName="FilterGroup" Content="Width" ToolTip.Tip="Widest images first" IsChecked="{Binding CurrentSortChoice, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Width}"/>
										</StackPanel>
									</Border>

									<TextBlock Classes="filterLabel" Text="Aspect ratio"/>
									<Border Classes="segmentTrack">
										<StackPanel Orientation="Horizontal" Spacing="2">
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="All" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=All}"/>
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="Portrait" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Vertical}"/>
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="4:3" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=4:3}"/>
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="16:9" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=16:9}"/>
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="16:10" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=16:10}"/>
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="21:9" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=21:9}"/>
											<RadioButton Classes="segmented" GroupName="AspectRatioGroup" Content="32:9" IsChecked="{Binding CurrentAspectRatio, Converter={StaticResource BoolToStrConverter}, ConverterParameter=32:9}"/>
										</StackPanel>
									</Border>

									<TextBlock Classes="filterLabel" Text="Colour (avg)"/>
									<Border Classes="segmentTrack">
										<StackPanel Orientation="Horizontal" Spacing="2">
											<RadioButton Classes="segmented" GroupName="ColourGroup" Content="Any" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=All}"/>
											<RadioButton Classes="segmented" GroupName="ColourGroup" ToolTip.Tip="Red" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Red}">
												<Ellipse Width="12" Height="12" Fill="#E24B4A"/>
											</RadioButton>
											<RadioButton Classes="segmented" GroupName="ColourGroup" ToolTip.Tip="Orange / yellow" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=OrangeYellow}">
												<Ellipse Width="12" Height="12" Fill="#F2A93B"/>
											</RadioButton>
											<RadioButton Classes="segmented" GroupName="ColourGroup" ToolTip.Tip="Green" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Green}">
												<Ellipse Width="12" Height="12" Fill="#4FAE5B"/>
											</RadioButton>
											<RadioButton Classes="segmented" GroupName="ColourGroup" ToolTip.Tip="Blue" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Blue}">
												<Ellipse Width="12" Height="12" Fill="#3A7FDB"/>
											</RadioButton>
											<RadioButton Classes="segmented" GroupName="ColourGroup" ToolTip.Tip="Violet" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Violet}">
												<Ellipse Width="12" Height="12" Fill="#8B6BDB"/>
											</RadioButton>
											<RadioButton Classes="segmented" GroupName="ColourGroup" ToolTip.Tip="Grey" IsChecked="{Binding ColourFilter, Converter={StaticResource BoolToStrConverter}, ConverterParameter=Grey}">
												<Ellipse Width="12" Height="12" Fill="#8A8A8A"/>
											</RadioButton>
										</StackPanel>
									</Border>

									<TextBlock Classes="filterLabel" Text="Show"/>
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Border Classes="segmentTrack">
											<ToggleButton Classes="segmented" Content="Folders" IsChecked="{Binding ShowFolders}"/>
										</Border>
										<Border Classes="segmentTrack">
											<ToggleButton Classes="segmented" Content="Favourites only" IsChecked="{Binding OnlyFavourites}"/>
										</Border>
										<Border Classes="segmentTrack">
											<ToggleButton Classes="segmented" Content="High-res only" ToolTip.Tip="Only images that have equal or higher resolution than your highest-resolution monitor" IsChecked="{Binding OnlyHighRes}"/>
										</Border>
									</StackPanel>

								</StackPanel>
							</Border>

						</Popup>


						<Button Grid.Row="1" Command="{Binding navigateToParentDirec}" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4, 6, 0, 0" ToolTip.Tip="Navigate Back">
							<Image Source="avares://Wallmod/Assets/back-icon.png" Width="20" Height="20"/>
						</Button>

						<Button Grid.Row="2" Command="{Binding selectedDirectory}" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4, 2, 0, 0" ToolTip.Tip="Search Directory">
							<Image Source="avares://Wallmod/Assets/search-folder-icon.png" Width="22" Height="22"/>
						</Button>

						<!-- Directory History (Recent Direcs) -->
						<Button x:Name="DirectoryHistoryButton" Grid.Row="2" Background="Transparent" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="4.5, 38, 0, 0" Command="{Binding directoryHistoryClicked}" ToolTip.Tip="Open Recent Directories">
							<Image Source="avares://Wallmod/Assets/directory-history-icon.png" Width="22" Height="22"/>
						</Button>
						<Popup PlacementTarget="{Binding #DirectoryHistoryButton}" Placement="RightEdgeAlignedTop" IsLightDismissEnabled="True" IsOpen="{Binding IsDirectoryHistoryOpen}">

							<Border Background="rgba(20, 20, 20, 15)" CornerRadius="8" Padding="8" MinWidth="220">
								<!-- shared size scope here (not on the ItemsControl) so the header lines up with the rows -->
								<StackPanel Spacing="2" Grid.IsSharedSizeScope="True">
									<TextBlock Text="Recently Opened" FontSize="13" Foreground="#99FFFFFF" Margin="4,0,0,10"/>
									<TextBlock Text="No recent directories" FontSize="12" Foreground="#99FFFFFF" Margin="4,2" IsVisible="{Binding !DirectoryHistoryList.Count}"/>

									<!-- column headers -->
									<Grid IsVisible="{Binding !!DirectoryHistoryList.Count}" Margin="0,0,0,2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" SharedSizeGroup="DirectoryHistoryCount"/>
											<ColumnDefinition Width="1"/>
											<ColumnDefinition Width="*"/>
										</Grid.ColumnDefinitions>
										<TextBlock Grid.Column="0" Text="Items" FontSize="9" Foreground="#80FFFFFF" HorizontalAlignment="Right" Margin="6,0,8,0"/>
										<TextBlock Grid.Column="2" Text="Folder" FontSize="9" Foreground="#80FFFFFF" Margin="8,0,6,0"/>
									</Grid>

									<ItemsControl ItemsSource="{Binding DirectoryHistoryList}">
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Button Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).openDirectoryHistoryCommand}"
														CommandParameter="{Binding DirecPath}" Background="Transparent" BorderThickness="0" CornerRadius="0" Padding="0"
														HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ToolTip.Tip="{Binding DirecPath}">
													<Grid>
														<Grid.ColumnDefinitions>
															<ColumnDefinition Width="Auto" SharedSizeGroup="DirectoryHistoryCount"/>
															<ColumnDefinition Width="1"/>
															<ColumnDefinition Width="*"/>
														</Grid.ColumnDefinitions>
														<TextBlock Grid.Column="0" Text="{Binding ItemCount}" FontSize="12" Foreground="#99FFFFFF" HorizontalAlignment="Right" Margin="6,5,8,5"/>
														<Border Grid.Column="1" Background="#33FFFFFF"/>
														<!-- display parent path and then child in accent colour -->
														<TextBlock Grid.Column="2" FontSize="12" MaxWidth="320" TextTrimming="PrefixCharacterEllipsis" Margin="8,5,6,5"
																   Foreground="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}">
															<!-- keep this weird formatting for the Runs so that theres no space between the two -->
															<Run Text="{Binding ParentPath}" Foreground="White" /><Run Text="{Binding FolderName}"/>
														</TextBlock>
													</Grid>
												</Button>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>
								</StackPanel>
							</Border>
						</Popup>


						<Border Grid.Row="2" Width="14" Height="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15, 78, 0, 0" Background="{Binding SelectedPreviewBackgroundColour, Converter={StaticResource ColorToBrushConverter}}"/>

						<Button Grid.Row="2" Command="{Binding uploadClicked}" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5, 88, 0, 0" ToolTip.Tip="Temporarily Add Image To Gallery">
							<Image Source="avares://Wallmod/Assets/addimgicon.png" Width="20" Height="20"/>
						</Button>


						<!-- View Favourites -->
						<Button Grid.Row="2" Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4, 0, 0, 44" Command="{Binding viewFavouritesButton}" ToolTip.Tip="View Favourites">
							<Image Source="avares://Wallmod/Assets/favourite-icon.png" Width="20" Height="20"/>
						</Button>

						<!-- View History -->
						<Button Grid.Row="2" Background="Transparent" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="4, 0, 0, 6" Command="{Binding viewHistoryButton}" ToolTip.Tip="View History">
							<Image Source="avares://Wallmod/Assets/historyicon.png" Width="20" Height="20"/>
						</Button>

						<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"
									HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0, 6, 0, 0">
							<TextBlock Text="{Binding CurrentSelectedDirecName}" FontSize="17" Foreground="White" VerticalAlignment="Center"
									   MaxWidth="260" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
							<TextBlock Text="{Binding GalleryCount}" FontSize="12" Foreground="#99FFFFFF" VerticalAlignment="Center"
									   ToolTip.Tip="Images in view"/>
						</StackPanel>

						<Grid Grid.Row="2" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0" Text="+"  Margin="2, 0, 8, 0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
							<Slider Grid.Row="1" x:Name="ThumbnailZoomSlider"
									Orientation="Vertical"
									Foreground="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
									Background="Gray"
									Minimum="50"
									Maximum="300"
									Value="{Binding ThumbnailZoomLevel}"
									HorizontalAlignment="Left"
									Margin="2"
									Width="35" Height="100"
									VerticalAlignment="Center"
									PointerWheelChanged="OnZoomSliderScroll"/>
							<TextBlock Grid.Row="2" Text="-" Margin="2, 0, 9, 0" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
						</Grid>

						<ScrollViewer Grid.Row="2" x:Name="ImageGalleryScrollView" VerticalScrollBarVisibility="Visible"
									  HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Stretch" Margin="45,12,45,15">

							<Interaction.Behaviors>
								<ia:VerticalScrollViewerAnimatedBehavior/>
							</Interaction.Behaviors>

							<!-- dont add <KeyDown="OnGalleryKeyDown"> since constructor handles it due to func -->
							<ListBox ItemsSource="{Binding DisplayWallpaperList}" x:Name="ImageViewControl" Background="Transparent"
									 SelectionChanged="OnGallerySelectionChanged"  DoubleTapped="OnImageDoubleTapped">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel Orientation="Horizontal"/>
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.Styles>
									<Style Selector="ListBoxItem">
										<Setter Property="CornerRadius" Value="10"/>
										<Setter Property="Margin" Value="4"/>
										<Setter Property="Padding" Value="5"/>
									</Style>
								</ListBox.Styles>

								<ListBox.ItemTemplate>
									<DataTemplate x:DataType="models:Wallpaper">
										<StackPanel Orientation="Vertical" Margin="4">
											<Panel>
												<Image Source="{Binding ImageThumbnailBitmap}"
													   Width="{Binding Value, ElementName=ThumbnailZoomSlider}"/>

												<Border IsVisible="{Binding IsDirectory}"
														CornerRadius="4"
														HorizontalAlignment="Center"
														VerticalAlignment="Bottom"
														Margin="8"
														Padding="4">
													<TextBlock Text="{Binding FolderItemCount}"
															   FontSize="10"
															   Foreground="White"/>
												</Border>

												<!-- corner badges: fixed slots (queue | heart in the corner), each with its own dark pill;
												     the heart slot stays reserved so a queue-only badge doesn't slide right -->
												<Grid ColumnDefinitions="15,2,15"
													  HorizontalAlignment="Right" VerticalAlignment="Top"
													  Margin="0,2,2,0" IsHitTestVisible="False">
													<Border Grid.Column="0" IsVisible="{Binding IsQueued}" Background="#B3141118" CornerRadius="4" Height="12" Padding="3,0">
														<Path Width="10" Height="9" Stretch="Uniform" VerticalAlignment="Center" Fill="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
															  Data="M1,2H15V6H1Z M1,9H15V13H1Z M1,16H10V20H1Z M16.5,12H20.5V15.5H24V19.5H20.5V23H16.5V19.5H13V15.5H16.5Z"/>
													</Border>
													<Border Grid.Column="2" IsVisible="{Binding IsFavourite}" Background="#B3141118" CornerRadius="4" Height="12" Padding="3,0">
														<Path Width="10" Height="9" Stretch="Fill" VerticalAlignment="Center" Fill="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
															  Data="M12,21.35L10.55,20.03C5.4,15.36 2,12.27 2,8.5C2,5.41 4.42,3 7.5,3C9.24,3 10.91,3.81 12,5.08C13.09,3.81 14.76,3 16.5,3C19.58,3 22,5.41 22,8.5C22,12.27 18.6,15.36 13.45,20.03L12,21.35Z"/>
													</Border>
												</Grid>
											</Panel>

											<TextBlock
												Text="{Binding Name}"
												TextWrapping="Wrap"
												MaxWidth="100"
												IsVisible="{Binding IsDirectory}"
												HorizontalAlignment="Center" VerticalAlignment="Center"
												Foreground="White" />
										</StackPanel>
									</DataTemplate>
								</ListBox.ItemTemplate>

							</ListBox>
						</ScrollViewer>

						<Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
								Background="Transparent" Margin="0,0,3,180" Click="JumpToTopClicked" ToolTip.Tip="Jump To Top">
							<Image Source="avares://Wallmod/Assets/jumptotop-icon.png" Width="20" Height="20"/>
						</Button>

						<Button Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
								Background="Transparent" Margin="0,0,3,150" Click="JumpToBottomClicked" ToolTip.Tip="Jump To Bottom">
							<Image Source="avares://Wallmod/Assets/jumptobot-icon.png" Width="20" Height="20"/>
						</Button>


					</Grid>

					<!-- History Section -->
					<Grid IsVisible="{Binding IsHistoryViewVisible}" Background="Transparent">
						<views:HistoryView />
					</Grid>

				</Panel>
			</Border>

			<!-- GridSplitter: Allows Resizing Between Left and Right Sections ========= -->
			<GridSplitter x:Name="MainVertSplitter" Grid.Column="1" Grid.Row="0" Width="5"
						  Background="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}" Margin="0,25,0,25"
						  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
						  ShowsPreview="False" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
						  DragStarted="GridSplitterDragExec" />

			<!-- Right Section: Preview and Controls ============================================================ -->
			<Border Grid.Column="2" Grid.Row="0" Background="{Binding SelectedPreviewBackgroundColour, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="10" Margin="8">

				<!-- scrolling preview / sticky action row / autoset + settings strip -->
				<Grid RowDefinitions="*,Auto,Auto">

					<!--PREVIEW SECTION =========-->
					<ScrollViewer VerticalScrollBarVisibility="Auto">
						<Interaction.Behaviors>
							<ia:VerticalScrollViewerAnimatedBehavior/>
						</Interaction.Behaviors>

						<Grid Margin="18, 6, 18, 0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>

							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
							</Grid.RowDefinitions>

							<TextBlock Text="Preview" FontWeight="Bold" FontSize="16"
									   Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
									   Foreground="White" HorizontalAlignment="Center"/>


							<!-- mirror preview horizontally (accent bg = currently mirrored) -->
							<Button Command="{Binding mirrorPreviewCommand}"
									Grid.Row="0" Grid.Column="0"
									HorizontalAlignment="Left"
									Background="{Binding MirrorButtonColour, Converter={StaticResource ColorToBrushConverter}}"
									ToolTip.Tip="Mirror Image Horizontally">
								<Image Source="avares://Wallmod/Assets/flip-icon.png" Width="15" Height="15"/>
							</Button>

							<Button Click="EnlargePreviewImg"
									Grid.Row="0" Grid.Column="1"
									HorizontalAlignment="Right"
									Background="Gray" ToolTip.Tip="Enlarge">
								<Image Source="avares://Wallmod/Assets/enlarge-icon.png"
									   Width="14" Height="14"/>
							</Button>

							<!-- monitor preview -->
							<Grid Grid.Row="1" Grid.ColumnSpan="2">
								<Image x:Name="PreviewImage"
									   Source="{Binding CurrentWallpaperPreview}"
									   Stretch="Uniform"/>

								<!-- draggable rect -->
								<Canvas x:Name="OverlayCanvas" Panel.ZIndex="999">
									<Rectangle x:Name="DragRect"
											   StrokeThickness="4"
											   Opacity="0.8"
											   IsVisible="False"
											   Width="100"
											   Height="100"
											   PointerPressed="DragRect_PointerPressed"
											   PointerMoved="DragRect_PointerMoved"
											   PointerReleased="DragRect_PointerReleased">
										<Rectangle.Fill>
											<LinearGradientBrush StartPoint="0,0" EndPoint="200,250">
												<GradientStop Offset="0" Color="rgba(255, 0, 227, 0.27)"/>
												<GradientStop Offset="0.33" Color="rgba(150, 0, 255, 0.27)"/>
												<GradientStop Offset="0.66" Color="rgba(0, 79, 255, 0.27)"/>
												<GradientStop Offset="0.88" Color="rgba(0, 180, 255, 0.27)"/>
												<GradientStop Offset="0.99" Color="rgba(0, 255, 245, 0.27)"/>
											</LinearGradientBrush>
										</Rectangle.Fill>
										<Rectangle.Stroke>
											<LinearGradientBrush StartPoint="0,0" EndPoint="200,200">
												<GradientStop Offset="0.6" Color="White"/>
												<GradientStop Offset="1" Color="Black"/>
											</LinearGradientBrush>
										</Rectangle.Stroke>
									</Rectangle>
									<!-- resize handle indicator: purely visual, sticks to DragRect's bottom-right -->
									<Path x:Name="DragRectHandle"
										  Data="M 0,14 L 14,14 L 14,0 Z"
										  Fill="White"
										  Opacity="0.8"
										  IsHitTestVisible="False"
										  IsVisible="False"/>
								</Canvas>
							</Grid>

							<!-- wallpaper Info: name takes whatever width the resolution doesn't -->
							<Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto">
								<Button Grid.Column="0" Command="{Binding openImageInExplorerCommand}"
										Margin="2" Background="Gray"
										VerticalAlignment="Center" ToolTip.Tip="Go To Image File">
									<Image Source="avares://Wallmod/Assets/open-icon.png"
										   Width="12" Height="10"/>
								</Button>
								<TextBlock Grid.Column="1" Text="{Binding CurrentWallpaperName}"
										   ToolTip.Tip="{Binding CurrentWallpaperName}"
										   FontSize="13" FontWeight="Bold"
										   Foreground="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
										   VerticalAlignment="Center" Margin="8,0,10,0"
										   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
								<!-- hover = aspect ratio + file size -->
								<TextBlock Grid.Column="2" Text="{Binding CurrentWallpaperSize}"
										   ToolTip.Tip="{Binding CurrentWallpaperDetails}"
										   FontSize="12" FontWeight="SemiBold"
										   Foreground="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
										   VerticalAlignment="Center" Margin="0,0,4,0"/>
							</Grid>


							<!-- monitors card: header / layout / mode + style -->
							<Border Grid.Row="3" Grid.ColumnSpan="2" Margin="0,12,0,0" Padding="10,8" CornerRadius="6"
									Background="#26000000" BorderBrush="#1FFFFFFF" BorderThickness="1">
								<Grid RowDefinitions="Auto,Auto,Auto">

									<!-- header -->
									<Grid Grid.Row="0" ColumnDefinitions="*,Auto">
										<TextBlock Text="Monitors" FontSize="13" FontWeight="SemiBold" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
										<Button Grid.Column="1"
												Command="{Binding #MainWindowAxaml.DetectMonitors}"
												Background="Transparent" BorderThickness="0" Width="24" Height="24" Padding="0"
												HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Cursor="Hand"
												ToolTip.Tip="Refresh Monitors (R)">
											<!-- icon spins half a turn on hover -->
											<Button.Styles>
												<Style Selector="Image">
													<Setter Property="RenderTransform" Value="rotate(0deg)"/>
													<Setter Property="Transitions">
														<Transitions>
															<TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.35" Easing="CubicEaseOut"/>
														</Transitions>
													</Setter>
												</Style>
												<Style Selector="Button:pointerover Image">
													<Setter Property="RenderTransform" Value="rotate(180deg)"/>
												</Style>
											</Button.Styles>
											<Image Source="avares://Wallmod/Assets/refresh-icon.png" Width="12" Height="12"/>
										</Button>
									</Grid>

									<!-- monitor layout (positions come from MonitorHelper.scaleUIBounds) -->
									<ItemsControl Grid.Row="1" ItemsSource="{Binding MonitorList}" HorizontalAlignment="Center" Margin="0,6,0,8">
										<ItemsControl.ItemsPanel>
											<ItemsPanelTemplate>
												<StackPanel Background="Transparent"
															Width="{x:Static helpers:MonitorHelper.CanvasWidth}"
															Height="{x:Static helpers:MonitorHelper.CanvasHeight}"/>
											</ItemsPanelTemplate>
										</ItemsControl.ItemsPanel>
										<ItemsControl.ItemTemplate>
											<DataTemplate>
												<Canvas>
													<Border Background="{Binding FillColour}"
															BorderThickness="1" CornerRadius="4" Cursor="Hand"
															Width="{Binding UIBounds.Width}" Height="{Binding UIBounds.Height}"
															Canvas.Left="{Binding UIBounds.X}" Canvas.Top="{Binding UIBounds.Y}"
															ToolTip.Tip="{Binding Description}"
															PointerPressed="OnPreviewMonitorTapped">
														<!-- 1px border that lights up on hover -->
														<Border.Styles>
															<Style Selector="Border">
																<Setter Property="BorderBrush" Value="#55506A"/>
																<Setter Property="Transitions">
																	<Transitions>
																		<BrushTransition Property="BorderBrush" Duration="0:0:0.12"/>
																	</Transitions>
																</Setter>
															</Style>
															<Style Selector="Border:pointerover">
																<Setter Property="BorderBrush" Value="#E6FFFFFF"/>
															</Style>
														</Border.Styles>
														<Panel>
															<TextBlock Text="{Binding DisplayNumber}" FontSize="11" FontWeight="SemiBold" Foreground="White"
																	   HorizontalAlignment="Center" VerticalAlignment="Center">
																<TextBlock.Effect>
																	<DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="1.5" Color="#3A3A3A"/>
																</TextBlock.Effect>
															</TextBlock>
															<Border IsVisible="{Binding IsPrimary}" Height="1" CornerRadius="1" Background="#E0B84D"
																	HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="4,0,4,3"/>
														</Panel>
													</Border>
												</Canvas>
											</DataTemplate>
										</ItemsControl.ItemTemplate>
									</ItemsControl>

									<!-- One | All + style -->
									<Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto">
										<Border Grid.Column="0" Classes="segmentTrack"
												Background="{Binding SelectedWallpaperCollectionColour, Converter={StaticResource ColorToBrushConverter}}">
											<StackPanel Orientation="Horizontal" Spacing="2">
												<RadioButton x:Name="SelectOneToggle"
															 Classes="segmented"
															 GroupName="MonitorMode"
															 Content="One"
															 IsChecked="True"
															 ToolTip.Tip="Click a monitor to set / crop for it (M)"
															 Background="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
															 IsCheckedChanged="OnSelectOneMonitorToggleChecked"/>
												<RadioButton x:Name="SelectAllToggle"
															 Classes="segmented"
															 GroupName="MonitorMode"
															 Content="All"
															 ToolTip.Tip="Set on every monitor (M)"
															 Background="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
															 IsCheckedChanged="OnSelectAllMonitorsToggleChecked"/>
											</StackPanel>
										</Border>

										<!-- One mode: Custom Area (drag the rect) + styles drawn for that monitor ; All mode: OS styles -->
										<ComboBox Grid.Column="2"
												  Background="#99000000" Foreground="White" CornerRadius="6"
												  ItemsSource="{Binding WallpaperStyleList}"
												  SelectedItem="{Binding SelectedWallpaperStyle}"
												  SelectionChanged="OnWallpaperStyleChanged"
												  ToolTip.Tip="Wallpaper Style"
												  BorderThickness="0"
												  MinWidth="160"
												  FontSize="12"
												  VerticalAlignment="Center">
											<ComboBox.SelectionBoxItemTemplate>
												<DataTemplate x:DataType="x:String">
													<StackPanel Orientation="Horizontal" Spacing="8">
														<TextBlock Text="Style" Foreground="#99FFFFFF"/>
														<TextBlock Text="{Binding}"/>
													</StackPanel>
												</DataTemplate>
											</ComboBox.SelectionBoxItemTemplate>
										</ComboBox>
									</Grid>
								</Grid>
							</Border>

						</Grid>
					</ScrollViewer>

					<!-- action row (sticky): addToAutoset + fav, then set bg taking the rest -->
					<Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="18,12,18,12">

						<!-- add to autoset queue (badge = how many times this image is already queued) -->
						<Panel Grid.Column="0">
							<Button Command="{Binding addWallpaperToAutoSetCommand}"
									Classes="iconOutline"
									Width="38" Height="38"
									ToolTip.Tip="{Binding QueueButtonTip}">
								<Image Source="avares://Wallmod/Assets/addtoqueue-icon.png" Width="17" Height="16"/>
							</Button>
							<Border IsVisible="{Binding !!QueueCount}" IsHitTestVisible="False"
									Background="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
									MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
									HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0">
								<TextBlock Text="{Binding QueueCount}" FontSize="10" FontWeight="Bold"
										   HorizontalAlignment="Center" VerticalAlignment="Center">
									<TextBlock.Effect>
										<DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="1.5" Color="#3A3A3A"/>
									</TextBlock.Effect>
								</TextBlock>
							</Border>
						</Panel>

						<!-- fav -->
						<Button Grid.Column="1"
								x:Name="FavouriteButton"
								Classes="iconOutline"
								Command="{Binding addWallpaperToFavouritesCommand}"
								Width="38" Height="38"
								Margin="8,0,0,0"
								Background="{Binding FavouriteButtonColour, Converter={StaticResource ColorToBrushConverter}}"
								ToolTip.Tip="Add To Favourites (F)">
							<Image Source="avares://Wallmod/Assets/favourite-icon.png" Width="17" Height="17"/>
						</Button>

						<!-- set background: label says what it'll do (Pick a monitor / Set on Monitor N / Set on all monitors) -->
						<Button Grid.Column="2"
								Name="SetBackgroundButton"
								Click="OnSetWallpaperClicked"
								FontWeight="Medium"
								Background="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
								Height="38"
								Margin="20,0,10,0"
								HorizontalAlignment="Stretch"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center"
								CornerRadius="8"
								ToolTip.Tip="Set As Background (B)"
								IsEnabled="{Binding SetBackgroundButtonEnabled}">
							<!-- white text on accent: super thin grey outline so it stays readable -->
							<TextBlock Text="{Binding SetButtonText}">
								<TextBlock.Effect>
									<DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="1.5" Color="#3A3A3A"/>
								</TextBlock.Effect>
							</TextBlock>
						</Button>
					</Grid>

					<!-- autoset (opens the tray; dot = running) + "added" note + settings (dot = update available) -->
					<Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0,1,0,0" Padding="10,6,10,8">
						<Grid ColumnDefinitions="Auto,*,Auto">
							<Button Command="{Binding autoSetNavCommand}" Background="Transparent" Padding="10,6" CornerRadius="8"
									ToolTip.Tip="Autoset (Shift+A)">
								<StackPanel Orientation="Horizontal" Spacing="8">
									<Image Source="avares://Wallmod/Assets/autoset-icon.png" Width="18" Height="17"/>
									<TextBlock Text="Autoset" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
									<Panel VerticalAlignment="Center">
										<Ellipse Width="7" Height="7"
												 Fill="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
												 IsVisible="{Binding #AutoSetPanel.((vm:AutoSetViewModel)DataContext).CustomAutoSetDisableButtonEnabled}"/>
										<Ellipse Width="7" Height="7"
												 Fill="{Binding SelectedPrimaryAccentColour, Converter={StaticResource ColorToBrushConverter}}"
												 IsVisible="{Binding #AutoSetPanel.((vm:AutoSetViewModel)DataContext).RandomAutoSetDisableButtonEnabled}"/>
									</Panel>
								</StackPanel>
							</Button>

							<!-- just queued something: points at where it went (fades in / out) -->
							<Border Grid.Column="1" Classes.shown="{Binding QueueAddedShown}" IsHitTestVisible="False"
									Background="#40000000" CornerRadius="6" Padding="8,3"
									HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
								<Border.Transitions>
									<Transitions>
										<DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
									</Transitions>
								</Border.Transitions>
								<Border.Styles>
									<Style Selector="Border:not(.shown)">
										<Setter Property="Opacity" Value="0"/>
									</Style>
								</Border.Styles>
								<TextBlock Text="{Binding QueueAddedText}" Foreground="#6CC47A" FontSize="13" FontWeight="SemiBold"/>
							</Border>

							<Button Grid.Column="2" Command="{Binding settingsButton}" Background="Transparent"
									Width="34" Height="34" Padding="0" CornerRadius="8"
									HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
									ToolTip.Tip="Settings (Shift+S)">
								<Panel>
									<Image Source="avares://Wallmod/Assets/settings-icon.png" Width="18" Height="18"/>
									<Ellipse Width="7" Height="7" Fill="#E0B84D"
											 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
											 IsVisible="{Binding UpdateAvailableVisible}"
											 ToolTip.Tip="Update available"/>
								</Panel>
							</Button>

						</Grid>
					</Border>

				</Grid>
			</Border>

			<!-- ========= full-width AutoSet tray (opened by the Autoset button) ========= -->
			<Border Grid.Row="1" Grid.ColumnSpan="3"
					Background="{Binding SelectedPreviewBackgroundColour, Converter={StaticResource ColorToBrushConverter}}"
					CornerRadius="10"
					Margin="8"
					IsVisible="{Binding IsAutoSetVisible}">
				<views:AutoSetView x:Name="AutoSetPanel"/>
			</Border>

		</Grid>

		<!-- HUGE Image Enlargement Display (covers entire area)-->
		<Image x:Name="EnlargedPreviewImage"
			   Source="{Binding EnlargedWallpaper}"
			   RenderOptions.BitmapInterpolationMode="HighQuality"
			   Stretch="Uniform"
			   IsVisible="{Binding EnlargedWallpaper, Converter={x:Static ObjectConverters.IsNotNull}}"
			   PointerPressed="OnEnlargedImageClick" />

		<!-- Settings (covers everything while open) -->
		<Grid Name="SettingsGrid" IsVisible="{Binding SettingsViewVisibility}">
			<views:SettingsView />
		</Grid>

	</Panel>

</Window>
