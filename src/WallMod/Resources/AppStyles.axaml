<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<Design.PreviewWith>
		<Border Padding="20">
			<!-- Add Controls for Previewer Here -->
		</Border>
	</Design.PreviewWith>

	<!-- only styles shared by many controls / views live here; one-off looks stay inline where they're used -->

	<!-- segmented One/All toggle ===== -->
	<!-- track (background = gallery colour, bound in MainWindow) -->
	<Style Selector="Border.segmentTrack">
		<Setter Property="CornerRadius" Value="6"/>
		<Setter Property="Padding" Value="2"/>
		<Setter Property="BorderBrush" Value="#26FFFFFF"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector=":is(ToggleButton).segmented">
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="Padding" Value="14,4"/>
		<Setter Property="CornerRadius" Value="4"/>
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<ControlTemplate>
				<Panel>
					<!-- accent fill is its own layer so it can be dimmed without dimming the text -->
					<Border Name="PART_Fill"
							Background="{TemplateBinding Background}"
							CornerRadius="{TemplateBinding CornerRadius}"
							Opacity="0.55"/>
					<ContentPresenter Content="{TemplateBinding Content}"
									  Foreground="{TemplateBinding Foreground}"
									  Padding="{TemplateBinding Padding}"
									  HorizontalAlignment="Center"
									  VerticalAlignment="Center">
						<ContentPresenter.Effect>
							<DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="1.5" Color="#3A3A3A"/>
						</ContentPresenter.Effect>
					</ContentPresenter>
				</Panel>
			</ControlTemplate>
		</Setter>
	</Style>
	<!-- unchecked = no accent; faint tint on hover -->
	<Style Selector=":is(ToggleButton).segmented:unchecked /template/ Border#PART_Fill">
		<Setter Property="Background" Value="Transparent"/>
	</Style>
	<Style Selector=":is(ToggleButton).segmented:unchecked:pointerover /template/ Border#PART_Fill">
		<Setter Property="Background" Value="#40FFFFFF"/>
	</Style>

	<!-- outlined icon buttons ===== -->
	<Style Selector="Button.iconOutline">
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="BorderBrush" Value="#6A6671"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="8"/>
	</Style>



	<!-- hide the mainwindow title text (we draw our own icon in MainWindow instead) -->
	<Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
		<Setter Property="IsVisible" Value="False"/>
	</Style>

	<!-- hide the mainwindow fullscreen caption button that v12 added beside minimize button -->
	<Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
		<Setter Property="IsVisible" Value="False"/>
		<Setter Property="Width" Value="0"/>
	</Style>


	<!-- ============ Hotkeys settings page ============ -->

	<Style Selector="TextBlock.hkPageTitle">
		<Setter Property="FontSize" Value="15"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Foreground" Value="White"/>
	</Style>

	<!-- section card -->
	<Style Selector="Border.hkCard">
		<Setter Property="Background" Value="#2E000000"/>
		<Setter Property="CornerRadius" Value="10"/>
		<Setter Property="Padding" Value="18,14"/>
	</Style>

	<!-- section title (accent colour is bound inline in the page) -->
	<Style Selector="TextBlock.hkSection">
		<Setter Property="FontSize" Value="14"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="Margin" Value="0,0,0,4"/>
	</Style>

	<!-- one hotkey row -->
	<Style Selector="Grid.hkRow">
		<Setter Property="Margin" Value="0,3"/>
	</Style>

	<Style Selector="TextBlock.hkDesc">
		<Setter Property="Foreground" Value="#DDDDDD"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Margin" Value="10,0,0,0"/>
	</Style>

	<!-- keycap look -->
	<Style Selector="Border.keycap">
		<Setter Property="Background" Value="#59000000"/>
		<Setter Property="BorderBrush" Value="#33FFFFFF"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="CornerRadius" Value="6"/>
		<Setter Property="Padding" Value="9,4"/>
		<Setter Property="MinWidth" Value="30"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>
	<Style Selector="Border.keycap > TextBlock">
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="FontSize" Value="13"/>
		<Setter Property="HorizontalAlignment" Value="Center"/>
	</Style>

	<!-- hidden feature rows -->
	<Style Selector="StackPanel.hfRow">
		<Setter Property="Margin" Value="0,4"/>
		<Setter Property="Spacing" Value="2"/>
	</Style>
	<Style Selector="TextBlock.hfName">
		<Setter Property="Foreground" Value="White"/>
		<Setter Property="FontWeight" Value="SemiBold"/>
		<Setter Property="FontSize" Value="13"/>
	</Style>
	<Style Selector="TextBlock.hfDesc">
		<Setter Property="Foreground" Value="#C9C9C9"/>
		<Setter Property="FontSize" Value="12.5"/>
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>

	<!-- every button keeps its own background/border/text on hover/press (Fluent swaps in grey), just darkened slightly -->
	<Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
		<Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}"/>
		<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
		<Setter Property="BoxShadow" Value="inset 0 0 0 100 #26000000"/>
	</Style>
	<Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
		<Setter Property="Background" Value="{Binding $parent[Button].Background}"/>
		<Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}"/>
		<Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}"/>
		<Setter Property="BoxShadow" Value="inset 0 0 0 100 #40000000"/>
	</Style>

</Styles>